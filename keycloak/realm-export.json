{
  "realm": "gym-bro",
  "enabled": true,
  "displayName": "Gym Bro",
  "displayNameHtml": "<b>Gym Bro</b>",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "de"
  ],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "gym-bro-app",
      "name": "Gym Bro App",
      "description": "Angular PWA client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard gym-bro user",
        "composite": false
      },
      {
        "name": "admin",
        "description": "Administrator",
        "composite": false
      }
    ]
  },
  "defaultRoles": [
    "user"
  ],
  "scopeMappings": [],
  "clientScopeMappings": {},
  "smtpServer": {},
  "loginTheme": "keycloak",
  "accountTheme": "keycloak.v3",
  "adminTheme": "keycloak.v2",
  "emailTheme": "keycloak",
  "eventsEnabled": false,
  "adminEventsEnabled": false,
  "users": [
    {
      "username": "lifter",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Lifter",
      "email": "lifter@gym-bro.local",
      "credentials": [
        {
          "type": "password",
          "value": "lifter",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-gym-bro"
      ]
    },
    {
      "username": "spotter",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Spotter",
      "email": "spotter@gym-bro.local",
      "credentials": [
        {
          "type": "password",
          "value": "spotter",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-gym-bro"
      ]
    }
  ]
}
